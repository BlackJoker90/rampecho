#!/usr/bin/python3
# pgen_hdmi_packet [slot ...]: print the infoframes the Pi 4 HDMI block of
# the connected port is sending, read from its packet RAM, one line per slot
# after a "port=" line:
#   slot=1 enabled=1 type=81 version=01 length=1b bytes=48:46:d0:00:...
# "bytes" starts with the checksum (PB0). A slot is on the wire when its
# bit in HDMI_RAM_PACKET_CONFIG is set ("enabled"); a disabled slot can
# still hold an old frame. Slots follow vc4: 1 vendor (VSIF), 3 SPD, 7 DRM.
# The AVI slot (2) does not decode with this layout; the AVI infoframe is in
# the kernel log ("AVI IF:"). Default: slots 1, 3 and 7. Needs root
# (/dev/mem). Python 3.5. The port is the connected HDMI-A-N connector
# (PGEN_HDMI_PORT=0|1 overrides); its packet region comes from the device
# tree, so HDMI1 (HDMI-A-2) is read from its own block, not from HDMI0.
# Only on a BCM2711 (Pi 4, Pi 400, CM4): on any other board, a Pi 5 among
# them, it prints "ERR ..." and no slot line, without opening /dev/mem.
# PGEN_DEVICE_TREE and PGEN_DEV_MEM replace /proc/device-tree and /dev/mem
# in tests. The device's caller (PGenerator_cmd.pl HDMI_PACKET, run through
# sudo) removes both before it starts this script.
import mmap
import os
import re
import struct
import sys

import glob

# "packet" regions of hdmi@7ef00700 / hdmi@7ef05700 (BCM2711), used when the
# device tree cannot be read.
PACKET_RAM_FALLBACK = {0: 0xfef01b00, 1: 0xfef06b00}
STRIDE = 0x24               # 9 words per slot
DT = os.environ.get("PGEN_DEVICE_TREE") or "/proc/device-tree"
DEV_MEM = os.environ.get("PGEN_DEV_MEM") or "/dev/mem"
DEBUGFS_DRI = os.environ.get("PGEN_DEBUGFS_DRI") or "/sys/kernel/debug/dri"
# Linux 6.9+ DRM HDMI connector debugfs files (0400, raw packed infoframes from
# hdmi_infoframe_pack): used on non-BCM2711 boards (Pi 5) without touching
# /dev/mem. Slot 1 (vendor/VSIF) is not mapped here because Pi 5 DV VSIF is
# written outside connector_state->hdmi.infoframes.
DEBUGFS_SLOTS = {2: "avi", 7: "hdr_drm"}


def board_compatible():
    """The root compatible strings, [] when unreadable."""
    try:
        with open(DT + "/compatible", "rb") as f:
            return [c.decode("ascii", "replace") for c in f.read().split(b"\0") if c]
    except (IOError, OSError):
        return []


def connected_port():
    env = os.environ.get("PGEN_HDMI_PORT", "")
    if env in ("0", "1"):
        return int(env), "HDMI-A-%d" % (int(env) + 1)
    for status in sorted(glob.glob("/sys/class/drm/card*-HDMI-A-*/status")):
        try:
            with open(status) as f:
                if f.read().startswith("connected"):
                    n = int(re.search(r"HDMI-A-(\d+)/status$", status).group(1))
                    return n - 1, "HDMI-A-%d" % n
        except (IOError, OSError, AttributeError, ValueError):
            pass
    return 0, "none"


def cells(path, default):
    try:
        with open(path, "rb") as f:
            return struct.unpack(">I", f.read(4))[0]
    except (IOError, OSError, struct.error):
        return default


def packet_ram(port):
    """CPU address of the port's "packet" region, from the device tree."""
    try:
        nodes = sorted(glob.glob(DT + "/soc/hdmi@*"), key=lambda n: int(n.split("@")[1], 16))
        node = nodes[port]
        with open(node + "/reg-names", "rb") as f:
            names = f.read().decode("ascii").rstrip("\0").split("\0")
        with open(node + "/reg", "rb") as f:
            reg = f.read()
        ac = cells(DT + "/soc/#address-cells", 1)
        sc = cells(DT + "/soc/#size-cells", 1)
        entry = 4 * (ac + sc)
        i = names.index("packet")
        bus = int.from_bytes(reg[i * entry:i * entry + 4 * ac], "big")
        # soc ranges: child (ac cells), parent (root #address-cells), size (sc)
        pc = cells(DT + "/#address-cells", 2)
        with open(DT + "/soc/ranges", "rb") as f:
            ranges = f.read()
        rlen = 4 * (ac + pc + sc)
        for k in range(0, len(ranges) - rlen + 1, rlen):
            r = ranges[k:k + rlen]
            child = int.from_bytes(r[:4 * ac], "big")
            parent = int.from_bytes(r[4 * ac:4 * (ac + pc)], "big")
            size = int.from_bytes(r[4 * (ac + pc):], "big")
            if child <= bus < child + size:
                return parent + (bus - child)
    except (IOError, OSError, IndexError, ValueError, UnicodeDecodeError):
        pass
    return PACKET_RAM_FALLBACK.get(port, PACKET_RAM_FALLBACK[0])


def regs_file(port):
    found = sorted(glob.glob("%s/*/hdmi%d_regs" % (DEBUGFS_DRI, port)))
    return found[0] if found else "%s/1/hdmi%d_regs" % (DEBUGFS_DRI, port)


def read_debugfs_slots(slots, connector):
    """Read Linux 6.9+ raw packed HDMI infoframes from debugfs (slots 2, 7)."""
    out = {}
    if not connector or connector == "none":
        return out
    for slot in slots:
        fname = DEBUGFS_SLOTS.get(slot)
        if not fname:
            continue
        found = sorted(glob.glob("%s/*/%s/infoframes/%s" % (DEBUGFS_DRI, connector, fname)))
        if not found:
            continue
        try:
            with open(found[0], "rb") as f:
                out[slot] = f.read(64)
        except (IOError, OSError):
            pass
    return out


def packet_config(regs):
    try:
        with open(regs) as f:
            m = re.search(r"HDMI_RAM_PACKET_CONFIG\s*=\s*(0x[0-9a-fA-F]+)", f.read())
        return int(m.group(1), 16) if m else None
    except (IOError, OSError):
        return None


def read_slots(slots, packet_base):
    # The map starts on an allocation boundary (4 KiB on the Pi).
    gran = mmap.ALLOCATIONGRANULARITY
    page = packet_base & ~(gran - 1)
    fd = os.open(DEV_MEM, os.O_RDONLY | os.O_SYNC)
    try:
        mem = mmap.mmap(fd, gran, mmap.MAP_SHARED, mmap.PROT_READ, offset=page)
    finally:
        os.close(fd)
    out = {}
    for slot in slots:
        off = packet_base - page + slot * STRIDE
        words = struct.unpack("<9I", mem[off:off + 36])
        header = [words[0] & 0xff, (words[0] >> 8) & 0xff, (words[0] >> 16) & 0xff]
        body = []
        # vc4_hdmi_write_infoframe: PB0..PB27 in groups of 7 bytes over
        # two words (4 + 3 bytes).
        for k in range(4):
            a, b = words[1 + 2 * k], words[2 + 2 * k]
            body += [a & 0xff, (a >> 8) & 0xff, (a >> 16) & 0xff, (a >> 24) & 0xff,
                     b & 0xff, (b >> 8) & 0xff, (b >> 16) & 0xff]
        out[slot] = (header, body[:header[2] + 1])
    mem.close()
    return out


def main():
    slots = [int(a) for a in sys.argv[1:]] or [1, 3, 7]
    compatible = board_compatible()
    port, name = connected_port()
    if "brcm,bcm2711" not in compatible:
        # The packet RAM address and layout are the BCM2711's; on another
        # chip (BCM2712: soc@107c000000, no "/soc" node) the fallback
        # address would read some other device through /dev/mem. On Linux
        # 6.9+ (Pi 5) read the kernel's debugfs infoframes for AVI/HDR DRM.
        dfs = read_debugfs_slots(slots, name)
        if not dfs:
            print("ERR packet RAM read on BCM2711 only (board: %s)" % (
                ", ".join(compatible) or "unknown"))
            return
        cfg = packet_config(regs_file(port))
        print("port=%s hdmi=%d source=debugfs" % (name, port))
        for slot, raw in sorted(dfs.items()):
            # Check both global VC4_HDMI_RAM_PACKET_ENABLE (bit 16) and the
            # slot bit when hdmiN_regs is readable; emit "?" when unreadable
            # (matching the BCM2711 path below).
            if cfg is None:
                enabled = "?"
            else:
                enabled = "1" if ((cfg & 0x10000) and ((cfg >> slot) & 1)) else "0"
            if len(raw) >= 4:
                header = [raw[0], raw[1], raw[2]]
                body = list(raw[3:3 + header[2] + 1])
                print("slot=%d enabled=%s type=%02x version=%02x length=%02x bytes=%s" % (
                    slot, enabled, header[0], header[1], header[2],
                    ":".join("%02x" % x for x in body)))
            else:
                # Emit a 1-byte zero body (PB0) so enabled=1 with an empty
                # debugfs file parses as type=00 (a counted mismatch) instead
                # of returning undef ("unreadable").
                print("slot=%d enabled=%s type=00 version=00 length=00 bytes=00" % (slot, enabled))
        return
    base = packet_ram(port)
    cfg = packet_config(regs_file(port))
    print("port=%s hdmi=%d packet=0x%08x" % (name, port, base))
    for slot, (header, body) in sorted(read_slots(slots, base).items()):
        enabled = "?" if cfg is None else str((cfg >> slot) & 1)
        print("slot=%d enabled=%s type=%02x version=%02x length=%02x bytes=%s" % (
            slot, enabled, header[0], header[1], header[2],
            ":".join("%02x" % x for x in body)))


if __name__ == "__main__":
    main()
